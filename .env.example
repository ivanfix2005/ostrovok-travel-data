# Copy to .env locally. Never commit real keys.
OSTROVOK_KEY_ID=
OSTROVOK_API_KEY=
YANDEX_RASP_API_KEY=
YANDEX_WEATHER_API_KEY=
DGIS_API_KEY=

# Provider URLs belong to configuration, never tool arguments.
OSTROVOK_BASE_URL=https://api.ostrovok.ru/api/b2b/v3/
YANDEX_RASP_BASE_URL=https://api.rasp.yandex-net.ru/v3.0/
YANDEX_WEATHER_URL=https://api.weather.yandex.ru/v2/forecast
DGIS_ROUTING_URL=https://routing.api.2gis.com/routing/7.0.0/global

# Enable caching ONLY when your provider agreement permits it.
CACHE_ALLOWED=false
CACHE_TTL_SECONDS=0
# Optional imported city index; built with import-stations outside tool calls.
YANDEX_CITIES_FILE=data/yandex-cities.json
# Optional hotel metadata from an authorised Ostrovok content dump.
OSTROVOK_HOTELS_FILE=data/ostrovok-hotels.json
