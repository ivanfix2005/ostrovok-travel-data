{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ostrovok-hackathon:travel-data:1.0.0:get_weather.request",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "maxLength": 120,
      "minLength": 1
    },
    "tool": {
      "const": "get_weather"
    },
    "arguments": {
      "type": "object",
      "properties": {
        "location": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": [
            "lat",
            "lon"
          ],
          "additionalProperties": false
        },
        "start_date": {
          "type": "string",
          "maxLength": 10,
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end_date": {
          "type": "string",
          "maxLength": 10,
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "location",
        "start_date",
        "end_date"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "tool",
    "arguments"
  ],
  "additionalProperties": false
}
