{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ostrovok-hackathon:travel-data:1.0.0:get_route.request",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "maxLength": 120,
      "minLength": 1
    },
    "tool": {
      "const": "get_route"
    },
    "arguments": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": [
            "lat",
            "lon"
          ],
          "additionalProperties": false
        },
        "destination": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": [
            "lat",
            "lon"
          ],
          "additionalProperties": false
        },
        "departure_at": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 40,
              "format": "date-time",
              "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "enum": [
            "car"
          ]
        }
      },
      "required": [
        "origin",
        "destination",
        "departure_at",
        "mode"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "tool",
    "arguments"
  ],
  "additionalProperties": false
}
